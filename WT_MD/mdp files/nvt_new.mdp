; NVT Equilibration - Gentle
integrator               = md
; Use a simple molecular dynamics integrator.
dt                       = 0.0005
; Very small timestep (0.5 fs) to prevent explosions.
nsteps                   = 2000000
; 1 ns of total simulation time (2000000 steps * 0.0005 ps/step).

; Output control
nstxout                  = 50000
nstvout                  = 50000
nstenergy                = 50000
nstlog                   = 50000
nstxout-compressed       = 50000

; Bonded settings
continuation             = yes
constraints              = all-bonds

; Non-bonded settings
cutoff-scheme            = Verlet
coulombtype              = PME
rcoulomb                 = 1.0
vdwtype                  = Cut-off
rvdw                     = 1.0
rlist                    = 1.0

; Temperature coupling
tcoupl                   = V-rescale
tc-grps                  = System
; Couple the entire system to a single thermostat.
tau_t                    = 0.5
; Slower temperature coupling time constant.
ref_t                    = 300
; Reference temperature is 300 K.
