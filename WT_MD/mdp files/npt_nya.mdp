; NPT Equilibration
integrator               = md
dt                       = 0.0005
nsteps                   = 2000000
; 1 ns total simulation time.

; Output control
nstxout                  = 50000
nstvout                  = 50000
nstenergy                = 50000
nstlog                   = 50000
nstxout-compressed       = 50000

; Bonded settings
continuation             = yes
constraints              = all-bonds

; Non-bonded settings
cutoff-scheme            = Verlet
coulombtype              = PME
rcoulomb                 = 1.0
vdwtype                  = Cut-off
rvdw                     = 1.0
rlist                    = 1.0

; Temperature coupling
tcoupl                   = V-rescale
tc-grps                  = System
tau_t                    = 0.5
ref_t                    = 300

; Pressure coupling
pcoupl                   = Parrinello-Rahman
pcoupltype               = isotropic
ref_p                    = 1.0
compressibility          = 4.5e-5
tau_p                    = 2.0
