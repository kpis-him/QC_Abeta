; RUN CONTROL
integrator = md
dt = 0.004           ; Timestep (ps) - Increased for faster simulation.
nsteps = 15000000    ; 200 ns total (0.004 * 50000000).

; OUTPUT CONTROL
nstxout = 0          ; Do not write positions to a trajectory file.
nstvout = 0          ; Do not write velocities to a trajectory file.
nstfout = 0          ; Do not write forces to a trajectory file.
nstlog = 5000        ; Update log file every 20 ps.
nstenergy = 5000     ; Update energy file every 20 ps.
nstxout-compressed = 500000 ; Write compressed trajectory every 2 ns to save space.

; BOND PARAMETERS
continuation = yes
constraint_algorithm = lincs
lincs_iter = 1
lincs_order = 4
; A 4 fs timestep is stable with LINCS constraints and should be used with Hydrogen Mass Repartitioning (HMR) for stability.

; NEIGHBORSEARCHING
cutoff-scheme = Verlet
ns_type = grid
nstlist = 40         ; Increased to reduce neighbor list updates for speed.
rlist = 1.0
coulombtype = PME
rcoulomb = 1.0
vdwtype = Cut-off
rvdw = 1.0
pbc = xyz

; TEMPERATURE AND PRESSURE COUPLING
tcoupl = v-rescale
tc-grps = System
tau-t = 0.1
ref-t = 300
pcoupl = parrinello-rahman
pcoupltype = isotropic
tau-p = 2.0
ref-p = 1.0
compressibility = 4.5e-5

; E-W
fourierspacing = 0.12
fourier_nx = 0
fourier_ny = 0
fourier_nz = 0
ewald_rtol = 1e-5
epsilon_surface = 0

; NO QM/MM FLAGS HERE - Handled by PLUMED
; The QM/MM interface is no longer configured in the MDP file.
; Instead, it is managed by the PLUMED file
