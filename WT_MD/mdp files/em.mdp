; GROMACS energy minimization for Amyloid-beta
; Generated based on best practices for modern GROMACS (5.0+)

; Run control
integrator  = steep         ; Steepest descent algorithm for minimization
nsteps      = 50000         ; Maximum number of steps to perform
emtol       = 1000.0        ; Stop minimization if the maximum force < 1000 kJ/mol/nm
emstep      = 0.01          ; Initial minimization step size

; Output control
nstlog      = 1000          ; Write log file every 1000 steps
nstenergy   = 1000          ; Write energies to energy file every 1000 steps

; Neighbor searching
cutoff-scheme   = Verlet    ; Recommended cutoff scheme for GROMACS 5 and later
ns_type         = grid      ; Grid-based neighbor searching
nstlist         = 10        ; Update neighbor list every 10 steps
rlist           = 1.2       ; Cutoff for the neighbor list (in nm)

; Electrostatics
coulombtype     = PME       ; Particle Mesh Ewald for long-range electrostatics
rcoulomb        = 1.2       ; Cutoff for short-range electrostatics (in nm)
fourierspacing  = 0.12      ; Grid spacing for PME

; Van der Waals
vdw-type        = cut-off   ; Simple cutoff method for VDW interactions
rvdw            = 1.2       ; Cutoff for VDW interactions (in nm)

; Constraints and other settings
constraints     = none      ; No constraints during energy minimization
; The following settings are off by default but good to be explicit
Tcoupl          = no        ; No temperature coupling
Pcoupl          = no        ; No pressure coupling
gen_vel         = no        ; No generation of velocities
