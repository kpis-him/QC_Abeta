; Production run for Amyloid-beta
; Generated based on NPT equilibration settings

; Run control
integrator  = md            ; Use the standard molecular dynamics integrator
nsteps      = 50000000      ; A 100 ns simulation (50,000,000 * 2 fs/step)
dt          = 0.002         ; Time step of 2 fs

; Output control
nstxout     = 50000         ; Save coordinates every 100 ps (100 ps / 2 fs = 50,000)
nstvout     = 50000         ; Save velocities
nstenergy   = 5000          ; Save energy to edr file every 10 ps
nstlog      = 5000          ; Save to log file every 10 ps

; Neighbor searching
cutoff-scheme   = Verlet
ns_type         = grid
nstlist         = 20
rlist           = 1.2
pbc             = xyz

; Electrostatics
coulombtype     = PME
rcoulomb        = 1.2
fourierspacing  = 0.12

; Van der Waals
vdw-type        = cut-off
rvdw            = 1.2
DispCorr        = EnerPres    ; Apply long range dispersion corrections

; Temperature and Pressure coupling
tcoupl      = V-rescale     ; Thermostat for temperature
tc-grps     = Protein_and_Ions Water ; Coupling groups
tau_t       = 0.1           ; Time constant for thermostat
ref_t       = 300           ; Reference temperature

pcoupl      = Parrinello-Rahman ; Barostat for pressure
pcoupltype  = isotropic
tau_p       = 2.0           ; Time constant for barostat
ref_p       = 1.0           ; Reference pressure (1 bar)
compressibility = 4.5e-5

; Position Restraints and Velocities
; Position restraints are REMOVED for production!
gen_vel     = no            ; Do not generate velocities
