; md.mdp - Production Molecular Dynamics
;
; Parameters for a long production simulation
; Following NPT equilibration
;

; Run parameters
integrator	= md		; leap-frog integrator
nsteps		= 25000000	; Total steps for 100 ns (2 fs * 50,000,000 steps)
dt		= 0.002		; 2 fs integration step

; Output control
nstxout-compressed = 10000   ; Save compressed coordinates (trajectory) every 20 ps (for 100 ns run)
nstvout		= 0           ; Do not save velocities
nstfout		= 0           ; Do not save forces
nstenergy	= 10000       ; Save energies every 20 ps (for 100 ns run)
nstlog		= 10000       ; Update log file every 20 ps

; Bond parameters
continuation	= yes		; Continue from checkpoint file (npt.cpt)
constraint_algorithm = lincs	; Holonomic constraints
constraints	= h-bonds	; Bonds involving H are constrained
lincs_iter	= 4		    ; Accuracy of LINCS
lincs_order	= 4		    ; Also related to accuracy

; Neighborsearching
cutoff-scheme	= Verlet
ns_type		= grid		; Search neighboring grid cells
nstlist		= 20	    ; Update neighbor list every 20 steps (40 fs)
rlist		= 1.2		; Short-range neighbor list cutoff (in nm)

; Electrostatics
rcoulomb	= 1.2		; Short-range electrostatic cutoff (in nm)
coulombtype	= PME		; Particle Mesh Ewald for long-range electrostatics
pme_order	= 4		    ; Cubic interpolation
fourierspacing	= 0.12		; Grid spacing for FFT

; VdW
vdw-type        = Cut-off   ; Use a simple cut-off (Shift is also common, but cut-off is fine)
rvdw            = 1.2       ; Short-range van der Waals cutoff (in nm)
rvdw-switch     = 1.1       ; Where the VdW potential starts to switch (slightly smaller than rvdw)

; Temperature coupling is on
tcoupl		= V-rescale	; Modified Berendsen thermostat
tc-grps		= system	; Coupled as one group
tau_t		= 0.1		; Time constant, in ps
ref_t		= 298.15	; Reference temperature, in K

; Pressure coupling is on
Pcoupl		= Parrinello-Rahman	; Isotropic pressure coupling
Pcoupltype	= isotropic
tau_p		= 1.0		; Time constant, in ps
compressibility	= 4.5e-5	; Water compressibility
ref_p		= 1.0		; Reference pressure, in bar

; Periodic boundary conditions
pbc		= xyz		; 3-D PBC

; Dispersion correction
DispCorr	= EnerPres	; Account for cut-off vdW scheme (corrects energy and pressure)

; Velocity generation - CRITICAL CHANGE FOR PRODUCTION
gen_vel		= no		; DO NOT generate new velocities; continue from .cpt file
; gen_temp	= 298.15    ; Not needed when gen_vel = no
; gen_seed	= -1        ; Not needed when gen_vel = no
